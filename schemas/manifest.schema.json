{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/SuJiuOvO/Toolbox-Community-Registry/main/schemas/manifest.schema.json",
  "title": "Multi-Toolbox Plugin Manifest Schema (v2.5)",
  "description": "Multi-Toolbox 动态功能模块与插件清单规范模式文件，用于 IDE 实时智能语法提示与校验。",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "category",
    "description",
    "author"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema 模式定义文件 URL"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "插件唯一英文标识符，必须与插件目录名完全一致，仅允许小写字母、数字和连字符(-)。例如: ncm-audio-converter"
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 60,
      "description": "插件的人类友好显示名称（支持中英文）。例如: 网易云音乐 NCM 极速批量转码"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$",
      "description": "插件版本号，遵循语义化版本规范 (Semantic Versioning)。例如: 1.0.0"
    },
    "minAppVersion": {
      "type": "string",
      "description": "运行当前插件所需的客户端最低 App 版本号。例如: 1.0.0"
    },
    "category": {
      "type": "string",
      "enum": [
        "media",
        "text",
        "dev",
        "system",
        "image",
        "audio",
        "video",
        "archive",
        "document",
        "network",
        "utility",
        "other",
        "win_ext"
      ],
      "description": "插件分类标签，决定在插件市场与分类筛选中的排布展示。"
    },
    "platforms": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "windows",
          "android",
          "universal"
        ]
      },
      "minItems": 1,
      "default": ["universal"],
      "description": "支持的目标操作系统列表。省略时客户端按 universal 处理；新插件建议显式声明。"
    },
    "executionType": {
      "type": "string",
      "enum": [
        "wasm",
        "quickjs",
        "native_executable",
        "script",
        "internal",
        "native_tool"
      ],
      "description": "执行引擎类型。native_tool 是现有内置流水线的历史值，新插件使用 internal。Windows 外部程序使用 native_executable 并提供 nativeRunner。"
    },
    "engineType": {
      "type": "string",
      "enum": [
        "wasm",
        "quickjs",
        "windows_extension",
        "internal",
        "native_image",
        "native_tool",
        "media_pipeline",
        "win_native_runner"
      ],
      "description": "历史兼容别名字段，建议优先使用 executionType。"
    },
    "description": {
      "type": "string",
      "description": "插件的详细功能与算法特性介绍，关键词会被客户端插件管理与市场实时检索。"
    },
    "author": {
      "type": "string",
      "description": "作者署名或组织名称。"
    },
    "icon": {
      "type": ["object", "string"],
      "if": {"type": "object"},
      "then": {
        "required": ["type"],
        "if": {"properties": {"type": {"const": "default"}}},
        "else": {"required": ["data"]}
      },
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "code",
            "image",
            "file",
            "material",
            "default"
          ],
          "description": "code 为内联 SVG，image/file 为图片，material 的 data 为图标关键词，default 使用客户端默认图标。"
        },
        "data": {
          "type": "string",
          "description": "图标数据内容。type=code 时为纯文本 SVG 矢量 XML，type=image 时为 data:image/png;base64,... 字符串。"
        },
        "maxSizeBytes": {
          "type": "integer",
          "minimum": 1,
          "default": 524288
        }
      },
      "description": "图标对象或客户端兼容的旧版字符串。新插件建议使用 currentColor 双色 SVG。"
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "network",
          "fs_unrestricted",
          "fs:unrestricted",
          "fs_read_parent_dir",
          "fs:read_directory",
          "fs:read_parent_dir",
          "storage",
          "storage_manage",
          "storage_all_files",
          "fs_all_files"
        ]
      },
      "description": "客户端实际识别的沙箱权限。联网使用 network，读取输入文件同级目录使用 fs:read_parent_dir，完全文件访问使用 fs:unrestricted。"
    },
    "inputs": {
      "type": "array",
      "description": "动态 Schema 驱动的表单输入项定义列表。",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "type"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "表单字段的唯一键名，在脚本中通过 params[id] 或模板变量 ${id} 提取。"
          },
          "label": {
            "type": "string",
            "description": "表单组件的展示标题。"
          },
          "type": {
            "type": "string",
            "enum": [
              "file_picker",
              "text",
              "textarea",
              "number",
              "slider",
              "switch",
              "select",
              "color_picker",
              "folder_picker"
            ],
            "description": "组件类型: file_picker(文件/目录选择器), text(文本框), number(数字微调), slider(连续滑块), switch(二元开关), select(下拉单选), color_picker(拾色器), folder_picker(输出目录选择器)。"
          },
          "required": {
            "type": "boolean",
            "default": false,
            "description": "是否为必填项。未填报时客户端会拦截执行并进行气泡提示。"
          },
          "allowMultiple": {
            "type": "boolean",
            "default": false,
            "description": "文件选择器是否允许多选。"
          },
          "defaultValue": {
            "description": "表单项初始化默认值。"
          },
          "placeholder": {
            "type": "string",
            "description": "输入框占位提示文本。"
          },
          "min": {
            "type": "number",
            "description": "数值或滑块最小值限制。"
          },
          "max": {
            "type": "number",
            "description": "数值或滑块最大值限制。"
          },
          "step": {
            "type": "number",
            "description": "滑块或数字微调器的步长。"
          },
          "allowedExtensions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "file_picker 组件允许选取的文件格式后缀列表（不含点，例如 [\"mp3\", \"flac\", \"ncm\"]）。"
          },
          "options": {
            "type": "array",
            "description": "select 下拉单选组件的可选项列表。",
            "items": {
              "type": "object",
              "required": [
                "label",
                "value"
              ],
              "properties": {
                "label": {
                  "type": "string",
                  "description": "选项展示文本"
                },
                "value": {
                  "description": "选项实际对应的值"
                }
              }
            }
          },
          "visibleIf": {
            "type": "object",
            "description": "高级动态条件联动展示规则。支持 field, value, in, or, and 等复合逻辑。"
          },
          "banners": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/bannerDef"
            },
            "description": "表单组件下方的提示横幅列表。"
          },
          "rejectedExtensions": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/rejectedExtensionDef"
            },
            "description": "专有受阻格式拦截与操作指引定义。"
          },
          "allowFolder": {
            "type": "boolean",
            "description": "file_picker 组件是否展示【添加文件夹】按钮。"
          },
          "allowFiles": {
            "type": "boolean",
            "default": true,
            "description": "file_picker 组件是否展示文件选择按钮。与 allowFolder 组合可实现仅文件、仅文件夹或两者同时显示。"
          },
          "pickButtonText": {
            "type": "string",
            "description": "自定义文件选择按钮文本。"
          },
          "selectionSummary": {
            "type": "string",
            "description": "自定义选中条目汇总文本模板 (支持 {count} 占位符)。"
          },
          "isArchive": {
            "type": "boolean",
            "description": "是否为压缩归档文件选择器 (在 Android 端启用特殊分卷兼容与专有图标)。"
          },
          "preserveDirectoryEntries": {
            "type": "boolean",
            "description": "是否保留文件夹原始目录结构而不递归扁平化展开为散列文件。"
          },
          "preserveDirectoryEntriesIf": {
            "type": "object",
            "description": "是否保留目录结构的动态条件规则。"
          }
        }
      }
    },
    "outputs": {
      "type": "array",
      "description": "声明式复合计算结果与富文本卡片排布规范 (Manifest v2.5 规范)。",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "输出字段 ID，与 JS 返回的 data[id] 键名严格匹配。"
          },
          "type": {
            "type": "string",
            "enum": [
              "copyable_text",
              "key_value_table",
              "markdown",
              "json_tree",
              "image_compare"
            ],
            "description": "输出渲染类型: copyable_text(带行号等宽拷贝框), key_value_table(高对比度键值表格), markdown(富文本排版渲染), json_tree(缩进两格的格式化JSON), image_compare(前后图片交互式滑动对比卡片)。"
          },
          "label": {
            "type": "string",
            "description": "结果卡片的标题文本。"
          },
          "description": {
            "type": "string",
            "description": "结果卡片的辅助说明提示。"
          }
        }
      }
    },
    "action": {
      "type": "object",
      "required": ["handler"],
      "additionalProperties": false,
      "properties": {
        "handler": {
          "type": "string",
          "minLength": 1,
          "description": "动作处理器标识。QuickJS 使用 quickjs_eval，WASM 使用 wasm_universal；客户端 1.1.0 的 internal 交互页面使用 handheld_bulletin、windows_uninstaller、ssh_terminal，必须声明 minAppVersion 1.1.0；原生工具由 nativeRunner 路由。"
        },
        "params": {
          "type": "object",
          "description": "动作参数映射。QuickJS 内联源码放在 script；外置源码使用约定的 entry.js/index.js/main.js/tool.js，客户端不读取 action.entry 或 scriptFile。"
        }
      },
      "description": "默认或通用的执行动作配置。"
    },
    "nativeRunner": {
      "type": "object",
      "required": [
        "entry"
      ],
      "properties": {
        "entry": {
          "type": "string",
          "minLength": 1,
          "description": "Windows 原生可执行文件相对路径。例如: bin/ffmpeg.exe 或 script.bat"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "命令行参数列表，支持 {inputs}、{input}、{outputDir} 与 {fieldName} 动态替换。"
        },
        "showTerminal": {
          "type": "boolean",
          "default": true,
          "description": "是否在界面下方展示流式终端黑色控制台与实时标准输出/错误流。"
        },
        "downloadUrls": {
          "type": "object",
          "description": "按需静默下载二进制的镜像下载源 (gitee, github, jsdelivr)。"
        },
        "sha256": {
          "type": "string",
          "description": "下载二进制文件的 SHA-256 完整性哈希校验值。"
        }
      },
      "description": "双端自适应 (Dual-Adaptive) 或 Windows 专用原生可执行程序配置块。"
    },
    "wasmRunner": {
      "type": "object",
      "required": [
        "entry"
      ],
      "properties": {
        "entry": {
          "type": "string",
          "minLength": 1,
          "description": "WASM 模块文件相对路径。例如: ncm_dumper.wasm"
        },
        "executionMode": {
          "type": "string",
          "enum": [
            "wasi_cli",
            "call_func",
            "memory_stream",
            "inspect"
          ],
          "default": "wasi_cli",
          "description": "客户端支持 wasi_cli、call_func、memory_stream 和 inspect。"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "完整 WASI argv 列表，第一项必须为程序名 (argv[0])，后续支持 {input}、{outputDir} 等参数模板。"
        },
        "batchMode": {
          "type": "boolean",
          "default": true,
          "description": "是否对多个输入文件逐一启动独立 WASM 实例批处理循环。"
        },
        "functionName": {
          "type": "string",
          "description": "call_func 或 memory_stream 模式下调用的导出函数名。"
        },
        "env": {
          "type": "object",
          "additionalProperties": {"type": "string"},
          "description": "注入 WASI 沙箱的环境变量字典。"
        },
        "showTerminal": {
          "type": "boolean",
          "default": true,
          "description": "是否展示 WASM 执行日志。"
        }
      },
      "description": "双端自适应 (Dual-Adaptive) 或 Android/通用 WASM 沙箱配置块。"
    },
    "banners": {
      "type": "array",
      "description": "声明式顶级提示横幅列表，展示于工具表单最上方，支持多平台区分与动态条件显隐。",
      "items": {
        "$ref": "#/definitions/bannerDef"
      }
    }
  },
  "allOf": [
    {
      "if": {"required": ["executionType"], "properties": {"executionType": {"const": "native_executable"}}},
      "then": {"required": ["nativeRunner"]}
    }
  ],
  "definitions": {
    "bannerDef": {
      "type": "object",
      "required": [
        "message"
      ],
      "properties": {
        "message": {
          "type": "string",
          "description": "提示横幅内容"
        },
        "type": {
          "type": "string",
          "enum": [
            "info",
            "warning",
            "success",
            "tip"
          ],
          "default": "info",
          "description": "横幅颜色样式"
        },
        "platform": {
          "type": "string",
          "enum": [
            "all",
            "universal",
            "windows",
            "android"
          ],
          "default": "all",
          "description": "适用的操作系统平台"
        },
        "icon": {
          "type": "string",
          "description": "横幅左侧图标标识"
        },
        "visibleIf": {
          "type": "object",
          "description": "动态联动显隐条件"
        }
      }
    },
    "rejectedExtensionDef": {
      "type": "object",
      "required": [
        "extensions",
        "message"
      ],
      "properties": {
        "extensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "受阻格式后缀列表 (如 [\".dwg\", \".dwf\"])"
        },
        "title": {
          "type": "string",
          "description": "拦截提示弹窗标题"
        },
        "message": {
          "type": "string",
          "description": "拦截引导说明与操作指导"
        }
      }
    }
  }
}
