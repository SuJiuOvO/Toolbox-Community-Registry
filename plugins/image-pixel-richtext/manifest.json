{
  "$schema": "../../schemas/manifest.schema.json",
  "id": "image-pixel-richtext",
  "name": "像素富文本工坊",
  "version": "2.0.0",
  "minAppVersion": "1.0.0",
  "category": "image",
  "platforms": [
    "windows",
    "android"
  ],
  "executionType": "wasm",
  "engineType": "wasm",
  "author": "Toolbox Community",
  "description": "一个插件完成图片像素转富文本、富文本像素画整理和富文本转彩色 PNG。支持 TextMeshPro 颜色标签、透明阈值、缩放、背景选择、批量图片与本地 WASI 沙箱处理。",
  "icon": {
    "type": "code",
    "data": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"5\" fill=\"currentColor\" fill-opacity=\"0.22\"/><path d=\"M6 7h5v10H6z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"/><path d=\"M13 7h5v4h-5zM13 13h5v4h-2.5v-1.5H13z\" fill=\"currentColor\"/><path d=\"M8 10h1M8 13h1\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linecap=\"round\"/></svg>"
  },
  "wasmRunner": {
    "entry": "bin/image_pixel_richtext.wasm",
    "executionMode": "wasi_cli",
    "args": [
      "image-pixel-richtext",
      "--mode",
      "{operation}",
      "-i",
      "{input}",
      "-o",
      "{outputDir}",
      "--text",
      "{richText}",
      "--max-width",
      "{maxWidth}",
      "--alpha-threshold",
      "{alphaThreshold}",
      "--scale",
      "{scale}",
      "--background",
      "{background}"
    ],
    "batchMode": true,
    "showTerminal": false
  },
  "inputs": [
    {
      "id": "operation",
      "label": "处理模式",
      "type": "select",
      "defaultValue": "image-to-richtext",
      "options": [
        {
          "label": "图片 → 富文本",
          "value": "image-to-richtext"
        },
        {
          "label": "富文本 → 彩色图片",
          "value": "richtext-to-image"
        },
        {
          "label": "富文本像素画（整理并预览）",
          "value": "richtext-pixel-art"
        }
      ]
    },
    {
      "id": "sourceImage",
      "label": "选择图片（支持 PNG / JPEG / WebP / BMP / GIF）",
      "type": "file_picker",
      "required": true,
      "allowMultiple": true,
      "allowedExtensions": [
        "png",
        "jpg",
        "jpeg",
        "webp",
        "bmp",
        "gif"
      ],
      "visibleIf": {
        "field": "operation",
        "equals": "image-to-richtext"
      }
    },
    {
      "id": "maxWidth",
      "label": "输出最大宽度（像素）",
      "type": "number",
      "defaultValue": 128,
      "description": "按比例缩小图片，避免富文本文件过大；不会放大原图。",
      "visibleIf": {
        "field": "operation",
        "equals": "image-to-richtext"
      }
    },
    {
      "id": "alphaThreshold",
      "label": "透明像素阈值（0-255）",
      "type": "number",
      "defaultValue": 16,
      "description": "Alpha 小于此值的像素输出为空格；不透明图片不受影响。",
      "visibleIf": {
        "field": "operation",
        "equals": "image-to-richtext"
      }
    },
    {
      "id": "richText",
      "label": "粘贴富文本像素画",
      "type": "textarea",
      "required": true,
      "defaultValue": "",
      "description": "支持 <color=#RRGGBB>、</color>、<size>、<line-height>、<br>，使用 █ 或 ■ 绘制像素，空格表示透明像素。",
      "visibleIf": {
        "field": "operation",
        "in": [
          "richtext-to-image",
          "richtext-pixel-art"
        ]
      }
    },
    {
      "id": "scale",
      "label": "预览放大倍数",
      "type": "slider",
      "defaultValue": 4,
      "min": 1,
      "max": 12,
      "step": 1,
      "visibleIf": {
        "field": "operation",
        "in": [
          "richtext-to-image",
          "richtext-pixel-art"
        ]
      }
    },
    {
      "id": "background",
      "label": "预览背景",
      "type": "select",
      "defaultValue": "dark",
      "options": [
        {
          "label": "深色（默认，透明像素显示为深色）",
          "value": "dark"
        },
        {
          "label": "透明（导出带 Alpha 的 PNG）",
          "value": "transparent"
        },
        {
          "label": "浅色（适合亮色像素画）",
          "value": "light"
        }
      ],
      "visibleIf": {
        "field": "operation",
        "in": [
          "richtext-to-image",
          "richtext-pixel-art"
        ]
      }
    }
  ],
  "action": {
    "handler": "wasm_universal",
    "params": {}
  }
}
